# CloudBase sets PORT automatically. Do not set it manually unless testing locally.
CLI_PROXY_API_KEY=replace-with-a-new-long-random-secret

# Optional: base64 of one Codex OAuth JSON file. Use a sensitive/encrypted
# CloudBase variable if available; Base64 itself is only encoding.
# CLI_PROXY_AUTH_JSON_B64=base64-encoded-codex-oauth-json
# CLI_PROXY_AUTH_VERSION=2026-09-02-1

# Optional API upstream. Leave all of these unset when using Codex OAuth.
# UPSTREAM_BASE_URL=https://api.example.com/v1
# UPSTREAM_API_KEY=replace-with-provider-api-key
# UPSTREAM_MODEL=replace-with-provider-model-id

# Optional client-facing alias. If omitted, the upstream model ID is used.
# UPSTREAM_MODEL_ALIAS=gpt-5.4

# Keep the default unless you mount a different persistent storage path.
CLI_PROXY_DATA_DIR=/data
